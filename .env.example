# ─── Required — Telegram ────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your channel ID (e.g. -1001234567890 for a private channel, or @channelname)
TELEGRAM_CHANNEL_ID=-1001234567890

# ─── Required — Server ──────────────────────────────────────────────────────
# Set automatically by Railway/Render. Only set manually if running locally.
PORT=8080
